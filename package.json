{
  "name": "unit-manager",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "dev": "vite",
    "server": "node server/index.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test server/*.test.ts src/*.test.ts"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  }
}
